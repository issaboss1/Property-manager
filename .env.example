# Copy this file to ".env" and fill in your details. Anything left blank is simply skipped.

# --- Shown on receipts ---
BUSINESS_NAME=My Properties
BUSINESS_ADDRESS=
BUSINESS_PHONE=

# --- Where YOUR alerts go (lease ending, late rent, AC servicing) ---
OWNER_EMAIL=
OWNER_WHATSAPP=

# --- Email (Gmail: turn on 2-Step Verification, then create an App Password at
#     https://myaccount.google.com/apppasswords and paste it below) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- WhatsApp Cloud API (see README, "Setting up WhatsApp") ---
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_API_VERSION=v21.0
WA_TEMPLATE_LANG=en
WA_TEMPLATE_RECEIPT=payment_receipt
WA_TEMPLATE_RENT_REMINDER=rent_reminder
WA_TEMPLATE_OWNER_ALERT=owner_alert

# --- Reminders ---
# Hour of the day (Trinidad time) the daily check runs
REMINDER_HOUR=8
# Also send tenants a reminder 3 days before rent is due and when it's late
SEND_TENANT_REMINDERS=true

# --- Security: set a password once the app is online (username can be anything) ---
APP_PASSWORD=
